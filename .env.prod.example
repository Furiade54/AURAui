# AuraUI VPS Monitor — Producción (opcional, NO es necesario rellenar)
# -----------------------------------------------------------------
# ATENCIÓN: NO necesitas poner aquí tu VPS real.
# El diseño de AuraUI recibe la conexión SSH DESDE el navegador
# (guardada en localStorage del cliente, SettingsApp > Conexión VPS).
#
# Este archivo EXISTE por si algún día quieres FORZAR una VPS concreta
# para TODOS los usuarios (modo "panel dedicado a un servidor").
# Si dejas en blanco todo lo de abajo, cada usuario introduce
# sus credenciales en Ajustes → Conexión VPS.

# SERVER_PORT ya viene definido en docker-compose, no hace falta repetir.
# SERVER_PORT=3001

# -------------------------------------------------------------------
# (OPCIONAL) Forzar credenciales VPS para TODAS las sesiones:
# Si rellenas VPS_HOST, todos los endpoints API usarán ESTA VPS,
# y no harán caso de lo que el usuario escriba en Ajustes.
# Deja vacío para "modo cliente".
# -------------------------------------------------------------------
# VPS_HOST=tu.ip.vps.prod
# VPS_PORT=22
# VPS_USER=root
# VPS_PASSWORD=cambia_esto_o_usa_la_private_key
# VPS_PRIVATE_KEY=
# VPS_PASSPHRASE=
# VPS_READY_TIMEOUT=15000
