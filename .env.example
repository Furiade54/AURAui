# ==========================================================================
# AuraUI VPS Monitor — Plantilla .env para DESARROLLO LOCAL (pnpm dev)
# --------------------------------------------------------------------------
# 🟢 ¿Necesario para Docker / producción?    —  NO. Ignóralo.
# 🟢 ¿Necesario para pnpm dev normal?       —  TAMPOCO (hay valores por
#                                               defecto y proxy Vite).
#
# Usa este fichero SOLO si:
#   · Estás desarrollando SIN el proxy Vite, o
#   · Quieres hacer pruebas locales contra una VPS concreta SIN tener que
#     meter credenciales cada vez en SettingsApp > Conexión VPS.
#
# Copiálo a .env.local para que Vite lo cargue (pnpm dev lo detecta):
#     cp .env.example .env.local
# Y rellena SOLO los campos que necesites.
# ==========================================================================

# Puerto backend Express (pnpm dev:server). Por defecto 50505 si se omite.
SERVER_PORT=50505

# VITE_API_BASE_URL — SOLO si sirves front/dist por un host/puerto DISTINTO
# al backend. Caso normal Docker + Vite proxy:  DEJAR COMENTADA.
# Así el front usa rutas relativas /api/*, /ws/* (sin CORS).
# VITE_API_BASE_URL="http://mi-otro-backend.example.com:50505"

# --------------------------------------------------------------------------
# (OPCIONAL) Credenciales VPS por defecto para DESARROLLO.
# ⚠️ NO PONGAS TUS CREDENCIALES REALES AQUÍ — este archivo es una PLANTILLA
# que se sube a Git. Usa .env.local (gitignored) para valores reales.
# Si se dejan vacíos, el usuario las introduce en la UI (modo normal).
# --------------------------------------------------------------------------
VPS_HOST="192.168.1.100"
VPS_PORT=22
VPS_USER="root"
VPS_PASSWORD=""
VPS_PRIVATE_KEY=""
VPS_PASSPHRASE=""
VPS_READY_TIMEOUT=15000
