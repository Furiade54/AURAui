GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

SERVER_PORT=50505
# VITE_API_BASE_URL solo es necesario si SERVES el front y el back en hosts/puertos DISTINTOS.
# Si usas Docker (mismo host/puerto = same-host) o pnpm dev (vite proxy) DEJA ESTA LÍNEA COMENTADA
# para usar rutas relativas (/api/..., /ws/...) contra la misma URL que carga la página.
# VITE_API_BASE_URL="http://mi-otro-backend:50505"

VPS_HOST="192.168.1.100"
VPS_PORT=22
VPS_USER="root"
VPS_PASSWORD=""
VPS_PRIVATE_KEY=""
VPS_PASSPHRASE=""
VPS_READY_TIMEOUT=15000
